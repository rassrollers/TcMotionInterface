    <Method Name="WriteCanOpenParameters" Id="{9ab97ec6-bc49-080a-0f71-d4ddc695e82c}">
      <Declaration><![CDATA[// Write CAN Open parameters to a CAN device
METHOD WriteCanOpenParameters : BOOL  // Return TRUE if successful
VAR_INPUT
	FilePath: STRING(255);  // Path to XML file, e.g. /home/Administrator/driveA.xml
	NetId: STRING(23);  // NetID of device in IO list
	CanId: UINT;  // CAN node ID
END_VAR
VAR_OUTPUT
	NumberOfParameterWritten: UDINT;  // Return number of parameter written to device
END_VAR]]></Declaration>
    </Method>
    <Method Name="WriteEtcDriveParameter" Id="{9c12efe9-0c44-0364-34f9-a551fa6219aa}">
      <Declaration><![CDATA[// Write COE parameters to a EtherCAT device
METHOD WriteEtcDriveParameter : BOOL  // Return TRUE if successful
VAR_INPUT
	FilePath: STRING(255);  // Path to XML file, e.g. /home/Administrator/driveA.xml
	NetId: STRING(23);  // NetID of device in IO list
	EtcAddress: UINT;  // EtherCAT address / Ams port
END_VAR
VAR_OUTPUT
	NumberOfParameterWritten: UDINT;  // Return number of parameter written to device
END_VAR
]]></Declaration>
    </Method>
  </Itf>
