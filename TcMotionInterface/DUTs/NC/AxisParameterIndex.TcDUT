<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.12">
  <DUT Name="AxisParameterIndex" Id="{cd3e1f16-d42a-0357-20d5-f36aa1f178a1}">
    <Declaration><![CDATA[// Parameters for NC axis.
// IndexGroup + AxisID.
// Remember to update array size accordingly.
// https://infosys.beckhoff.com/english.php?content=../content/1033/tc3_ads_intro/713092619.html&id=1285928777053769402
TYPE AxisParameterIndex :
STRUCT
	IndexGroup: UDINT := 16#4000;
	Parameters: ARRAY[0..39] OF ParameterSet := [
		(Name:= 'NC axis type',											IndexOffset:= 16#00000003, ReadOnly:= TRUE,		Length:= 4),  // 0
		(Name:= 'Homing Velocity (towards plc cam)',					IndexOffset:= 16#00000006, ReadOnly:= FALSE,	Length:= 8),
		(Name:= 'Homing Velocity (off plc cam)',						IndexOffset:= 16#00000007, ReadOnly:= FALSE,	Length:= 8),
		(Name:= 'Manual Velocity (Slow)',								IndexOffset:= 16#00000008, ReadOnly:= FALSE,	Length:= 8),
		(Name:= 'Manual Velocity (Fast)',								IndexOffset:= 16#00000009, ReadOnly:= FALSE,	Length:= 8),
		(Name:= 'Rapid Traverse Velocity (G0)',							IndexOffset:= 16#0000000A, ReadOnly:= FALSE,	Length:= 8),
		(Name:= 'Position Range Monitoring',							IndexOffset:= 16#0000000F, ReadOnly:= FALSE,	Length:= 2),
		(Name:= 'Position Range Window',								IndexOffset:= 16#00000010, ReadOnly:= FALSE,	Length:= 8),
		(Name:= 'Motion Monitoring',									IndexOffset:= 16#00000011, ReadOnly:= FALSE,	Length:= 2),
		(Name:= 'Motion Monitoring Time,',								IndexOffset:= 16#00000012, ReadOnly:= FALSE,	Length:= 8),
		(Name:= 'Target Position Monitoring',							IndexOffset:= 16#00000015, ReadOnly:= FALSE,	Length:= 2),
		(Name:= 'Trget Position Window',								IndexOffset:= 16#00000016, ReadOnly:= FALSE,	Length:= 8),
		(Name:= 'Target Position Monitoring Time',						IndexOffset:= 16#00000017, ReadOnly:= FALSE,	Length:= 8),
		(Name:= 'Jog Increment (Forward)',								IndexOffset:= 16#00000018, ReadOnly:= FALSE,	Length:= 8),
		(Name:= 'Jog Increment (Backward)',								IndexOffset:= 16#00000019, ReadOnly:= FALSE,	Length:= 8),
		(Name:= 'Error Propagation Mode',								IndexOffset:= 16#0000001A, ReadOnly:= FALSE,	Length:= 4),
		(Name:= 'Error Propagation Delay',								IndexOffset:= 16#0000001B, ReadOnly:= FALSE,	Length:= 8),
		(Name:= 'Couple slave to actual values if not enabled',			IndexOffset:= 16#0000001C, ReadOnly:= FALSE,	Length:= 2),
		(Name:= 'Fast Axis Stop Signal Type (optional)',				IndexOffset:= 16#0000001E, ReadOnly:= FALSE,	Length:= 4),
		(Name:= 'Allow motion commands to slave axis',					IndexOffset:= 16#00000020, ReadOnly:= FALSE,	Length:= 2),
		(Name:= 'Allow motion commands to external setpoint axis',		IndexOffset:= 16#00000021, ReadOnly:= FALSE,	Length:= 2),
		(Name:= 'Maximum Velocity',										IndexOffset:= 16#00000027, ReadOnly:= FALSE,	Length:= 8),
		(Name:= 'Motion Monitoring Window',								IndexOffset:= 16#00000028, ReadOnly:= FALSE,	Length:= 8),
		(Name:= 'In-Target Alarm',										IndexOffset:= 16#00000029, ReadOnly:= FALSE,	Length:= 2),
		(Name:= 'Data Persistence',										IndexOffset:= 16#00000030, ReadOnly:= TRUE,		Length:= 2),
		(Name:= 'In-Target Timeout',									IndexOffset:= 16#0000002A, ReadOnly:= FALSE,	Length:= 8),
		(Name:= 'Backlash',												IndexOffset:= 16#0000002C, ReadOnly:= FALSE,	Length:= 8),
		(Name:= 'Maximum Acceleration',									IndexOffset:= 16#000000F1, ReadOnly:= FALSE,	Length:= 8),
		(Name:= 'Maximum Deceleration',									IndexOffset:= 16#000000F2, ReadOnly:= FALSE,	Length:= 8),
		(Name:= 'Default Acceleration',									IndexOffset:= 16#00000101, ReadOnly:= FALSE,	Length:= 8),
		(Name:= 'Default Deceleration',									IndexOffset:= 16#00000102, ReadOnly:= FALSE,	Length:= 8),
		(Name:= 'Default Jerk',											IndexOffset:= 16#00000103, ReadOnly:= FALSE,	Length:= 8),
		(Name:= 'Dead Time Compensation (Delay Velo and Position)',		IndexOffset:= 16#00000104, ReadOnly:= FALSE,	Length:= 8),
		(Name:= 'Velocity Override Type',								IndexOffset:= 16#00000105, ReadOnly:= FALSE,	Length:= 4),
		(Name:= 'Velo Jump Factor',										IndexOffset:= 16#00000106, ReadOnly:= FALSE,	Length:= 8),
		(Name:= 'Tolerance ball auxiliary axis',						IndexOffset:= 16#00000108, ReadOnly:= FALSE,	Length:= 8),
		(Name:= 'Max. position deviation, aux. axis',					IndexOffset:= 16#00000109, ReadOnly:= FALSE,	Length:= 8),
		(Name:= 'Fast Acceleration (optional)',							IndexOffset:= 16#0000010A, ReadOnly:= FALSE,	Length:= 8),
		(Name:= 'Fast Deceleration (optional)',							IndexOffset:= 16#0000010B, ReadOnly:= FALSE,	Length:= 8),
		(Name:= 'Fast Jerk (optional)',									IndexOffset:= 16#0000010C, ReadOnly:= FALSE,	Length:= 8)   // 39
	];
END_STRUCT
END_TYPE
]]></Declaration>
  </DUT>
</TcPlcObject>